FROM tensorflow/tensorflow:2.21.0-gpu

WORKDIR /app

# Copy requirements and install them explicitly
COPY api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

EXPOSE 8888

# Use the full path to jupyter to prevent $PATH errors
CMD ["python", "-m", "jupyter", "notebook", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root"]